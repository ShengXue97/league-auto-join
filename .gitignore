# Personal settings (ntfy topic, auto-accept state) - created on first run
config.json

# Raw League client captures (contain game/player IDs)
capture/

__pycache__/
*.pyc

# Local scratch files (screenshots etc.)
tmp/

# Your SP change history (the client does not keep one)
rank_history.jsonl
rank_history.jsonl.last

# Match history saved beyond the client's 100-game limit
history_cache.json
